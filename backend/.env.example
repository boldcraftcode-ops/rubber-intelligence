# =============================================================================
#  Contoh isi backend/.env  —  SALIN menjadi backend/.env lalu sesuaikan.
#      Windows :  copy backend\.env.example backend\.env
#      Linux/Mac:  cp backend/.env.example backend/.env
#  Berkas .env TIDAK ikut masuk Git (berisi rahasia). Berkas ini contoh saja.
# =============================================================================

# development = dipakai di komputer sendiri; produksi = server/deploy.
APP_ENV=development

# Kunci untuk menandatangani sesi login. WAJIB diisi (minimal 32 karakter)
# bila APP_ENV=produksi. Buat nilai acak dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-kunci-acak-minimal-32-karakter

# Sandi akun admin pertama (dipakai sekali saat tabel pengguna masih kosong).
# Setelah bisa masuk, segera ganti sandi lewat menu (kanan atas > Ganti sandi).
ADMIN_SANDI_AWAL=admin123

# -----------------------------------------------------------------------------
#  Login
#  Aplikasi hanya memakai login USERNAME + SANDI (tabel pengguna di database).
#  Login Cloudflare Access sudah DIHAPUS dan tidak bisa diaktifkan lagi;
#  variabel CF_ACCESS_* / AUTH_MODE lama boleh dihapus dari .env.
# -----------------------------------------------------------------------------

# Alamat tampilan web yang diizinkan memanggil API (CORS). Kosong = tanpa CORS
# (frontend dev memakai proxy satu-origin).
# FRONTEND_ORIGIN=https://domain-aplikasi-anda

# -----------------------------------------------------------------------------
#  Deploy lewat Cloudflare Tunnel
#  Bila tampilan web dan API berada di SITUS BERBEDA (mis. frontend di
#  <proyek>.pages.dev / <proyek>.workers.dev, API di api.domain-anda.com),
#  setel baris di bawah menjadi none. Tanpa ini login akan tampak berhasil
#  lalu kembali lagi ke form, karena browser tidak mengirim cookie
#  SameSite=lax pada permintaan lintas situs.
#  Bila keduanya satu domain (app.domain-anda.com + api.domain-anda.com),
#  biarkan kosong / "lax".
# -----------------------------------------------------------------------------
# COOKIE_SAMESITE=none

# Sajikan tampilan web (frontend/dist) langsung dari API -> satu-origin.
# Pilihan paling sederhana untuk Cloudflare Tunnel: satu hostname tunnel
# melayani halaman + API, cookie sesi selalu terkirim, tanpa CORS.
# Butuh `npm run build` di folder frontend lebih dulu.
# SAJIKAN_WEB=true
# SAJIKAN_WEB_FOLDER=C:\op-margin\frontend\dist   # opsional, bila folder lain

# Pindah ke PostgreSQL (opsional):
# DATABASE_URL=postgresql+psycopg://user:sandi@localhost:5432/opmargin
